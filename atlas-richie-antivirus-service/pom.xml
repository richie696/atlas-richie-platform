<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.richie696.base</groupId>
        <artifactId>atlas-richie-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../atlas-richie-base/atlas-richie-dependencies/pom.xml</relativePath>
    </parent>

    <groupId>cn.richie696.antivirus</groupId>
    <artifactId>atlas-richie-antivirus-service</artifactId>
    <packaging>jar</packaging>
    <description>异步文件病毒扫描服务：Nacos 注册、Gateway HTTP 接入、Redis 任务状态与 Redis Stream 队列。</description>

    <properties>
        <!-- 均可通过同名 -D 参数覆盖；目标镜像名不要包含 tag，tag 由 docker.image.version 统一提供。 -->
        <docker.image.version>${revision}</docker.image.version>
        <jib.from.image>localhost:55000/atlas-richie-antivirus-runtime:clamav-debian13-slim-jre25</jib.from.image>
        <jib.to.image>localhost:55000/${project.artifactId}:local</jib.to.image>
        <jib.allow.insecure.registries>false</jib.allow.insecure.registries>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.richie696.base</groupId>
            <artifactId>atlas-richie-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-component-cache</artifactId>
            <version>${middle.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-component-redis-streammq</artifactId>
            <version>${middle.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <allowInsecureRegistries>${jib.allow.insecure.registries}</allowInsecureRegistries>
                    <from>
                        <image>${jib.from.image}</image>
                    </from>
                    <to>
                        <image>${jib.to.image}</image>
                        <tags>
                            <tag>${docker.image.version}</tag>
                            <tag>latest</tag>
                        </tags>
                    </to>
                    <extraDirectories>
                        <permissions>
                            <permission>
                                <file>/opt/antivirus/bin/start-antivirus.sh</file>
                                <mode>755</mode>
                            </permission>
                        </permissions>
                    </extraDirectories>
                    <container>
                        <creationTime>EPOCH</creationTime>
                        <user>1000:1000</user>
                        <workingDirectory>/app</workingDirectory>
                        <entrypoint>
                            <entry>/opt/antivirus/bin/start-antivirus.sh</entry>
                        </entrypoint>
                        <environment>
                            <TZ>Asia/Shanghai</TZ>
                            <ANTIVIRUS_CLAMAV_ENABLED>true</ANTIVIRUS_CLAMAV_ENABLED>
                            <ANTIVIRUS_CLAMAV_SOCKET_PATH>/tmp/clamd.sock</ANTIVIRUS_CLAMAV_SOCKET_PATH>
                            <CLAMD_STARTUP_TIMEOUT>300</CLAMD_STARTUP_TIMEOUT>
                        </environment>
                        <ports>
                            <port>9600</port>
                        </ports>
                        <labels>
                            <maintainer>richie696@icloud.com</maintainer>
                            <name>${project.artifactId}</name>
                            <description>${project.description}</description>
                        </labels>
                    </container>
                    <platforms>
                        <platform>
                            <os>linux</os>
                            <architecture>arm64</architecture>
                        </platform>
                    </platforms>
                    <outputPaths>
                        <tar>${project.build.directory}/${project.artifactId}-image.tar</tar>
                        <digest>${project.build.directory}/${project.artifactId}-image.digest</digest>
                        <imageId>${project.build.directory}/${project.artifactId}-image.id</imageId>
                        <imageJson>${project.build.directory}/${project.artifactId}-image.json</imageJson>
                    </outputPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>package-container-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>buildTar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
