{
  "schemaVersion": "1",
  "component": "atlas-richie-oauth-resource-server",
  "bindings": [
    {
      "property": "platform.oauth.resource-server.introspection-client-secret",
      "logicalName": "oauth.resource-server.introspection-client-secret",
      "kind": "CLIENT_SECRET",
      "exposure": "PROPERTY_SOURCE",
