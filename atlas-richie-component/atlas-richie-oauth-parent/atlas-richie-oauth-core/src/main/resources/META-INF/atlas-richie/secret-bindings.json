{
  "schemaVersion": "1",
  "component": "atlas-richie-oauth-core",
  "bindings": [
    {
      "property": "platform.component.oauth.token-secret",
      "logicalName": "oauth.token-secret",
      "kind": "TOKEN_SECRET",
      "exposure": "PROPERTY_SOURCE",
      "requiredWhen": {
        "property": "platform.component.oauth.enabled",
        "in": ["true"]
      },
      "refresh": "STATIC",
      "owner": "atlas-richie-oauth",
      "allowLocalWhenDisabled": true,
      "maxLength": 8192
    }
  ]
}
