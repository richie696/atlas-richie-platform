<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.richie696.component</groupId>
        <artifactId>atlas-richie-oauth-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>atlas-richie-oauth-test</artifactId>
    <name>atlas-richie-oauth-test</name>
    <description>OAuth 协议测试工具和共享测试夹具</description>
    <dependencies>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-authz</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-oauth-resource-server</artifactId>
        </dependency>
        <!--
            oauth-test 是被 AS/Gateway 测试代码以 test scope 引入的测试工具包。
            这些依赖必须在本模块的主类路径上，否则外部工程无法编译本模块导出的
            集成测试基类和 Spring/JUnit 注解。
        -->
        <dependency>
            <groupId>cn.richie696.base</groupId>
            <artifactId>atlas-richie-testing-support</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
