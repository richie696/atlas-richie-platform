{
  "schemaVersion": "1",
  "component": "atlas-richie-secret-bootstrap-test",
  "bindings": [
    {
      "property": "platform.component.test.access-key-secret",
      "logicalName": "test.access-key-secret",
      "kind": "ACCESS_KEY_SECRET",
      "exposure": "PROPERTY_SOURCE",
      "requiredWhen": {
        "property": "platform.component.test.engine",
        "in": ["remote"]
      },
      "refresh": "STATIC",
      "owner": "test",
      "allowLocalWhenEnabled": true,
      "maxLength": 128
    },
    {
      "property": "platform.component.test.native-key",
      "logicalName": "test.native-key",
      "kind": "PRIVATE_KEY",
      "exposure": "NATIVE_HANDLE",
      "refresh": "NATIVE",
      "owner": "test"
    },
    {
      "property": "platform.component.ai.chat.{name}.api-keys[{index}]",
      "logicalName": "test.ai.api-key",
      "kind": "API_KEY",
      "exposure": "PROPERTY_SOURCE",
      "refresh": "RECREATE_CLIENT",
      "owner": "test",
      "maxLength": 512
    }
  ]
}
