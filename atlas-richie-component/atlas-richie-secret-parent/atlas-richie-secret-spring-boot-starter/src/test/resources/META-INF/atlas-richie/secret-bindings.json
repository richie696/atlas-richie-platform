{
  "schemaVersion": "1",
  "component": "secret-refresh-test",
  "bindings": [
    {
      "property": "test.component.password",
      "logicalName": "test.component.password",
      "kind": "PASSWORD",
      "exposure": "PROPERTY_SOURCE",
      "requiredWhen": {
        "property": "platform.component.test.engine",
        "in": ["remote"]
      },
      "refresh": "REFRESH_SERVICE",
      "owner": "secret-refresh-test",
      "allowLocalWhenEnabled": true,
      "maxLength": 128
    },
    {
      "property": "platform.component.test.api-key",
      "logicalName": "test.api-key",
      "kind": "API_KEY",
      "exposure": "PROPERTY_SOURCE",
      "refresh": "REFRESH_SERVICE",
      "owner": "secret-actuator-test",
      "maxLength": 128
    },
    {
      "property": "platform.component.ai.chat.{name}.api-keys[{index}]",
      "logicalName": "test.ai.api-key",
      "kind": "API_KEY",
      "exposure": "PROPERTY_SOURCE",
      "refresh": "RECREATE_CLIENT",
      "owner": "secret-actuator-test",
      "maxLength": 512
    }
  ]
}
