<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.richie696.component</groupId>
        <artifactId>atlas-richie-vector-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>atlas-richie-vector-vikingdb</artifactId>
    <name>atlas-richie-vector-vikingdb</name>
    <description>Richie VikingDB 向量数据库组件</description>

    <!--
      Spring Cloud Alibaba BOM currently selects the Android fastjson2 artifact.
      VikingDB's JVM signer requires com.alibaba.fastjson2.util.Wrapper, which is
      absent from that variant, so keep the override local to this adapter.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.58</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.richie696.component</groupId>
            <artifactId>atlas-richie-vector-core</artifactId>
        </dependency>
        <!-- 版本由 atlas-richie-ai-bom（在 atlas-richie-dependencies 导入）统一管理。 -->
        <dependency>
            <groupId>cn.richie696.ai</groupId>
            <artifactId>atlas-richie-ai-vikingdb-store</artifactId>
        </dependency>
        <!-- Lombok 仅用于本模块编译，不向消费者传递 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>cn/richie696/component/vector/config/VikingDbVectorProviderFactory*</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <configuration>
                            <includes>
                                <include>cn/richie696/component/vector/config/VikingDbVectorProviderFactory*</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
